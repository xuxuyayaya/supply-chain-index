page{height:100%;background:#f5f6f8;color:#25282c;font-family:sans-serif}.page{height:100vh;display:flex;flex-direction:column}.brand{background:#991d28;padding:30rpx 42rpx;color:#fff;font-size:30rpx;font-weight:bold}.brand image{width:340rpx;display:block}.content{flex:1;min-height:0}.paper{max-width:1100rpx;margin:0 auto;background:#fff;padding:48rpx 42rpx 55rpx;box-sizing:border-box}.title{font-size:43rpx;font-weight:bold;line-height:1.65;text-align:center;white-space:pre-wrap;margin-bottom:40rpx}.paragraph{display:block;font-size:32rpx;line-height:1.95;text-align:justify;margin:0 0 28rpx}.section-title{font-size:33rpx;font-weight:bold;margin:36rpx 0 12rpx}.issuer{font-size:30rpx;line-height:1.9;text-align:right;white-space:pre-wrap;margin-top:40rpx}.respond{border-top:1px solid #e1e5e9;margin-top:46rpx;padding-top:36rpx}.response-title{font-size:36rpx;font-weight:bold;margin-bottom:30rpx}.confirmed{color:#1d6b45}.company{font-size:32rpx;line-height:1.8}.label{font-size:30rpx;margin-bottom:15rpx}.select,.other{border:1px solid #c9cdd3;border-radius:8rpx;padding:24rpx;font-size:30rpx;box-sizing:border-box}.select{display:flex;justify-content:space-between}.other{height:100rpx;margin-top:20rpx}.note{color:#6d737a;font-size:26rpx;line-height:1.8;margin:24rpx 0}.primary,.secondary{font-size:32rpx;border-radius:10rpx;line-height:1.6;padding:22rpx 16rpx}.primary{background:#991d28;color:white}.primary[disabled]{background:#d5d8dd;color:#616872}.secondary{background:#f1f3f5;color:#25282c}.error{font-size:28rpx;line-height:1.8;color:#9e1c25;margin-top:25rpx}.footer{font-size:25rpx;text-align:center;padding:28rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));color:#6d737a}.pdf-canvas{position:fixed;left:-2500px;top:0;width:620px;height:877px;pointer-events:none}